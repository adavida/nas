{
  "annotations": { "list": [] },
  "editable": false,
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["nas"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "title": "System (CPU / RAM / Disk)",
  "uid": "nas-system",
  "panels": [
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "max": 100, "min": 0, "unit": "percent", "custom": { "fillOpacity": 10 } },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[$__rate_interval])))",
          "legendFormat": "CPU busy",
          "refId": "A"
        }
      ],
      "title": "CPU usage",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "id": 2,
      "targets": [
        { "datasource": "Prometheus", "expr": "node_load1", "legendFormat": "load 1m", "refId": "A" },
        { "datasource": "Prometheus", "expr": "node_load5", "legendFormat": "load 5m", "refId": "B" },
        { "datasource": "Prometheus", "expr": "node_load15", "legendFormat": "load 15m", "refId": "C" }
      ],
      "title": "Load average",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "max": 100,
          "min": 0,
          "unit": "celsius",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "red", "value": 80 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "id": 3,
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "node_hwmon_temp_celsius",
          "legendFormat": "{{chip}} {{sensor}}",
          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "expr": "node_thermal_zone_temp",
          "legendFormat": "zone {{index}}",
          "refId": "B"
        }
      ],
      "title": "Temperatures",
      "type": "gauge"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "max": 100,
          "min": 0,
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 75 },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 4, "x": 0, "y": 8 },
      "id": 4,
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)",
          "instant": true,
          "legendFormat": "used",
          "refId": "A"
        }
      ],
      "title": "RAM used",
      "type": "gauge"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "unit": "bytes", "custom": { "fillOpacity": 10 } },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 4, "y": 8 },
      "id": 5,
      "targets": [
        { "datasource": "Prometheus", "expr": "node_memory_MemTotal_bytes", "legendFormat": "total", "refId": "A" },
        { "datasource": "Prometheus", "expr": "node_memory_MemAvailable_bytes", "legendFormat": "available", "refId": "B" },
        { "datasource": "Prometheus", "expr": "node_memory_MemFree_bytes", "legendFormat": "free", "refId": "C" },
        { "datasource": "Prometheus", "expr": "node_memory_Cached_bytes + node_memory_Buffers_bytes", "legendFormat": "cache+buffers", "refId": "D" }
      ],
      "title": "Memory detail",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "max": 100,
          "min": 0,
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 75 },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "id": 6,
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "100 * (1 - node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|squashfs\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay|squashfs\"})",
          "instant": true,
          "legendFormat": "{{mountpoint}}",
          "refId": "A"
        }
      ],
      "title": "Disk usage per mountpoint",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "max": 100, "min": 0, "unit": "percent", "custom": { "fillOpacity": 10 } },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "id": 7,
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "100 * rate(node_disk_io_time_seconds_total[$__rate_interval])",
          "legendFormat": "{{device}}",
          "refId": "A"
        }
      ],
      "title": "Disk I/O utilization",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "unit": "Bps", "custom": { "fillOpacity": 10 } },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "id": 8,
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(node_disk_read_bytes_total[$__rate_interval])",
          "legendFormat": "read {{device}}",
          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "expr": "rate(node_disk_written_bytes_total[$__rate_interval])",
          "legendFormat": "write {{device}}",
          "refId": "B"
        }
      ],
      "title": "Disk throughput",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "max": 70,
          "min": 0,
          "unit": "celsius",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 45 },
              { "color": "red", "value": 55 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "id": 9,
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "smartctl_temperature_celsius",
          "legendFormat": "{{device}} {{serial_number}}",
          "refId": "A"
        }
      ],
      "title": "Disk temperatures (SMART)",
      "type": "gauge"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": { "color": "red", "index": 1, "text": "FAIL" },
                "1": { "color": "green", "index": 0, "text": "OK" }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 24 },
      "id": 10,
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "smartctl_device_smart_status",
          "instant": true,
          "legendFormat": "{{device}}",
          "refId": "A"
        }
      ],
      "title": "SMART overall health",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "unit": "s", "color": { "mode": "thresholds" } },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 24 },
      "id": 11,
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "smartctl_device_power_on_seconds",
          "instant": true,
          "legendFormat": "{{device}}",
          "refId": "A"
        }
      ],
      "title": "Disk power-on time",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "unit": "Bps", "custom": { "fillOpacity": 10 } },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "id": 12,
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(node_network_receive_bytes_total{device!~\"lo|veth.*|br.*|docker.*|virbr.*\"}[$__rate_interval])",
          "legendFormat": "rx {{device}}",
          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "expr": "rate(node_network_transmit_bytes_total{device!~\"lo|veth.*|br.*|docker.*|virbr.*\"}[$__rate_interval])",
          "legendFormat": "tx {{device}}",
          "refId": "B"
        }
      ],
      "title": "Network throughput",
      "type": "timeseries"
    }
  ]
}
